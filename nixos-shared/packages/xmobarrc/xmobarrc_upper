Config { font = "xft:SauceCodePro Nerd Font Bold 10"
       , bgColor = "black"
       , fgColor = "lightgray"
       , position = TopW L 100
       , lowerOnStart = False
       , pickBroadest = False
       , commands = [ Run Network "@wirelessInterface@"
                        [ "-t", "<rx> 󰁅 <tx> 󰁝"
                        , "--minwidth", "2"
                        , "--maxwidth", "8"
                        , "-L" , "20"
                        , "-H" ,"1000"
                        , "--normal","#42d3a5"
                        , "--high", "red"
                        ] 10

                    , Run Com "@wirelessSsid@/bin/wirelessSsid" [] "wifi" 50
                    , Run MultiCpu
                        [ "-t", "(<total>)"
                        , "-L","10"
                        , "-H","40"
                        , "--normal","#42d3a5"
                        , "--high","red"
                        , "-p", "3"
                        , "-S", "True"
                        ] 10
                    , Run Memory
                        [ "-t", "<usedratio>%"
                        ] 300
                    , Run MultiCoreTemp
                        [ "-t", "<max>°C"
                        , "-L", "60"
                        , "-H", "85"
                        , "--normal", "#42d3a5"
                        , "--high", "red"
                        ] 50
                    , Run TopProc
                        [ "-t", "<both1>  <both2>  <mboth1>  <mboth2>"
                        , "-L", "25"
                        , "-H", "70"
                        , "--normal","#42d3a5"
                        , "--high","red"
                        , "--minwidth", "8"
                        ] 10
                    , Run BatteryP ["BAT0"]
                        [ "-t","<left> <timeleft> <acstatus>"
                        , "-L","20"
                        , "-H","70"
                        , "--low","red"
                        , "--normal","white"
                        , "--high" ,"#42d3a5"
                        , "--minwidth","2"
                        , "--"
                        , "-i","<fc=lightgreen>󰂄</fc>"
                        , "-O","<fc=orange>󱧥</fc>"
                        , "-o","<fc=red>󰂃</fc>"
                        -- re-fires every refresh while below threshold and
                        -- discharging; dunstify -r replaces its own popup
                        , "-a", "@dunst@/bin/dunstify -r 42001 -u critical 'Battery low'"
                        , "-A", "5"
                        ] 50
                    , Run DiskU
                        [("/","<usedp>% <used>/<size>")]
                        ["-L", "80", "-H", "90", "-m", "1", "-p", "2"]
                        100
                    , Run DiskIO
                        [("/", "<read> <write>")]
                        []
                        10
                    , Run Date "%F %T" "date" 10
                    , Run Com "@isVpnActive@/bin/isVpnActive" [] "vpn" 100
                    , Run Com "@dunstStatus@/bin/dunstStatus" [] "dunst" 20
                    , Run Com "@xmobarSharingIndicator@/bin/xmobarSharingIndicator" [] "sharing" 20
                    , Run Com "@btHeadphoneBattery@/bin/btHeadphoneBattery" [] "btheadphones" 60
                    -- 15s: this is the energy_now delta sampling window, not just a refresh
                    , Run Com "@chargeRate@/bin/chargeRate" [] "charge" 150
                    ]
       , sepChar = "%"
       , alignSep = "}{"
       , template = "%multicpu% 󰔏 %multicoretemp% %top% }{  󰍛 %memory%  󰋊 %disku% %diskio%  %@wirelessInterface@% %wifi% %vpn%  %charge%%battery%%btheadphones%  %dunst%%sharing%<fc=orange>%date%</fc>"
       }
